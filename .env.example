# --- Nuevas variables (todas opcionales; estos son los valores por defecto) ---
# Consultas de red (WHOIS, SSL, desacortador). Ponlo en false para trabajar sin conexión.
ENABLE_NETWORK_CHECKS=true
# false = solo desacorta bit.ly, tinyurl, t.co, etc.; true = sigue redirecciones de cualquier URL
UNSHORTEN_ALL=false
NETWORK_TIMEOUT=5
MAX_REDIRECTS=8
MAX_URLS_ANALISIS=3
# Caché de dictámenes de IA y de reportes PDF
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
REPORT_TTL_SECONDS=3600
